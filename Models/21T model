import torch
import torch.nn as nn
import torch.nn.functional as F


class MoEBlock(nn.Module):
    """A simple Mixture-of-Experts feed-forward block."""
    def __init__(self, dim, expert_count=4, expert_hidden=2048*64):
        super().__init__()
        self.expert_count = expert_count
        self.experts = nn.ModuleList([
            nn.Sequential(
                nn.Linear(dim, expert_hidden),
                nn.ReLU(),
                nn.Linear(expert_hidden, dim)
            ) for _ in range(expert_count)
        ])
        self.gate = nn.Linear(dim, expert_count)

    def forward(self, x):
        is_batched = x.dim() == 3
        if not is_batched:
            x = x.unsqueeze(1)
            
        B, T, D = x.shape
        x_flat = x.view(-1, D)
        
        gates = self.gate(x_flat)
        k = min(2, self.expert_count)
        
        topk_vals, topk_idx = torch.topk(gates, k, dim=-1)
        topk_weights = F.softmax(topk_vals, dim=-1)
        
        out_flat = torch.zeros_like(x_flat)
        
        # Auxiliary load balancing metrics
        router_probs = F.softmax(gates, dim=-1)
        P_i = router_probs.mean(dim=0)
        mask_1hot = F.one_hot(topk_idx, num_classes=self.expert_count).sum(dim=1).float()
        f_i = mask_1hot.mean(dim=0)
        aux_loss = self.expert_count * torch.sum(P_i * f_i)
        
        for i, expert in enumerate(self.experts):
            mask = (topk_idx == i).any(dim=-1)
            if not mask.any():
                continue
            
            tokens = x_flat[mask]
            expert_out = expert(tokens)
            
            idx_mask = (topk_idx[mask] == i)
            weights = (idx_mask * topk_weights[mask]).sum(dim=-1, keepdim=True)
            
            out_flat[mask] += expert_out * weights

        out = out_flat.view(B, T, D)
        return (out.squeeze(1) if not is_batched else out), aux_loss


class TransformerBlock(nn.Module):
    """A minimal transformer block with self-attention and MoE FFN."""
    def __init__(self, dim, nhead=4, expert_count=256, expert_hidden=2048*64):
        super().__init__()
        self.attn = nn.MultiheadAttention(dim, nhead, batch_first=True)
        self.norm1 = nn.LayerNorm(dim)
        self.norm2 = nn.LayerNorm(dim)
        self.moe = MoEBlock(dim, expert_count=expert_count, expert_hidden=expert_hidden)

    def forward(self, x, is_causal=True):
        T = x.size(1)
        
        # Autoregressive causal mask
        if is_causal:
            attn_mask = torch.triu(torch.ones(T, T, device=x.device), diagonal=1).bool()
        else:
            attn_mask = None
            
        attn_out, _ = self.attn(x, x, x, attn_mask=attn_mask, need_weights=False)
        x = self.norm1(x + attn_out)
        
        # Feed-forward processing with load tracking
        ffn_out, aux_loss = self.moe(x)
        x = self.norm2(x + ffn_out)
        return x, aux_loss


class DQN(nn.Module):
    def __init__(self, input_dim=256, hidden=128):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(input_dim, hidden),
            nn.ReLU(),
            nn.Linear(hidden, 2)
        )
    def forward(self, x):
        return self.net(x)


class AlphaRDT(nn.Module):
    """A sequential model with a dynamic looped transformer and improved header."""
    def __init__(
        self,
        vocab_size,
        model_dim,
        nhead=4,
        expert_count=4,
        expert_hidden=2048,
        max_seq_len=512,
        min_depth=2,
        max_depth=25,
    ):
        super().__init__()
        self.max_seq_len = max_seq_len
        self.min_depth = min_depth
        self.max_depth = max_depth
        self.depth_choices = max_depth - min_depth + 1

        self.token_emb = nn.Embedding(vocab_size, model_dim)
        self.pos_emb = nn.Embedding(max_seq_len, model_dim)
        
        self.header = nn.Sequential(
            nn.Linear(model_dim, model_dim),
            nn.GELU(),
            nn.LayerNorm(model_dim),
            nn.Linear(model_dim, model_dim),
            nn.GELU(),
        )
        
        # Sequential unshared layer instantiations
        total_layers = self.min_depth + self.depth_choices
        self.layers = nn.ModuleList([
            TransformerBlock(
                model_dim,
                nhead=nhead,
                expert_count=expert_count,
                expert_hidden=expert_hidden,
            ) for _ in range(total_layers)
        ])
        
        self.depth_gate = nn.Linear(model_dim, self.depth_choices)
        self.output_norm = nn.LayerNorm(model_dim)
        
        self.tail = nn.Sequential(
            nn.Linear(model_dim, model_dim),
            nn.GELU(),
            nn.Linear(model_dim, vocab_size),
        )

    def forward(self, x):
        """Forward with dynamic loop depth between min_depth and max_depth."""
        B, T = x.shape
        if T > self.max_seq_len:
            raise ValueError(f"Sequence length {T} exceeds max_seq_len={self.max_seq_len}")

        x = self.token_emb(x)
        x = self.header(x)
        pos = torch.arange(T, device=x.device).unsqueeze(0).expand(B, T)
        x = x + self.pos_emb(pos)

        pooled = x.mean(dim=1)
        depth_logits = self.depth_gate(pooled)
        depth_probs = F.softmax(depth_logits, dim=-1)

        final_x = torch.zeros_like(x)
        total_aux_loss = 0.0
        layer_idx = 0
        
        # Internal layer-by-layer tracking allocations
        intermediate_states = []
        
        # Layer execution and loss aggregation
        for _ in range(self.min_depth):
            x, aux_loss = self.layers[layer_idx](x, is_causal=True)
            total_aux_loss += aux_loss
            layer_idx += 1
        intermediate_states.append(x)
            
        for d in range(self.depth_choices):
            prob = depth_probs[:, d].view(B, 1, 1)
            final_x = final_x + x * prob
            if d < self.depth_choices - 1:
                x, aux_loss = self.layers[layer_idx](x, is_causal=True)
                total_aux_loss += aux_loss
                layer_idx += 1
                if d % max(1, self.depth_choices // 3) == 0:
                    intermediate_states.append(x)

        final_x = self.output_norm(final_x)
        logits = self.tail(final_x)
        return logits, final_x, total_aux_loss, intermediate_states


if __name__ == '__main__':

    training = torch.randint(0, 512000, (4, 8))
    testing = torch.randint(0, 512000, (2, 8))
    training_targets = torch.randint(0, 512000, (4, 8))
    testing_targets = torch.randint(0, 512000, (2, 8))
    
    model_dim = 16384
    VOCAB = 512000

    # Approximate 21T parameter configuration
    model = AlphaRDT(
        vocab_size=512000,
        model_dim=16384,
        nhead=128,
        expert_count=65,
        expert_hidden=65536,
        min_depth=5,
        max_depth=149
    )

    dqn = DQN(input_dim=model_dim, hidden=128)

    optimizer = torch.optim.AdamW(model.parameters(), lr=1e-3)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=5, eta_min=1e-5)
    criterion = nn.CrossEntropyLoss()

    model.train()
    for epoch in range(5):
        optimizer.zero_grad()
        out, hidden, aux_loss, stages = model(training)

        loss_ce = criterion(out.view(-1, VOCAB), training_targets.view(-1))

        # Context evaluation subset selection
        all_sampled_states = []
        for stage_tensor in stages + [hidden]:
            B, T, D = stage_tensor.shape
            flat_tokens = stage_tensor.view(-1, D)
            total_tokens = flat_tokens.size(0)
            
            sample_count = max(1, int(total_tokens * 0.10))
            idx = torch.randperm(total_tokens)[:sample_count]
            all_sampled_states.append(flat_tokens[idx])
        
        combined_samples = torch.cat(all_sampled_states, dim=0)
        probs = F.softmax(dqn(combined_samples), dim=-1)
        
        # Absolute structural misgating extraction penalization
        unallprob = probs[:, 1].max()

        # variable unallprob is the softmax output of the DQN
        if unallprob.item() > 0.5:
            total_loss = ((unallprob * (1 / 0.5))**2 + loss_ce + aux_loss) / 2
        else:
            total_loss = loss_ce + aux_loss

        total_loss.backward()
        optimizer.step()
        scheduler.step()
        print(f"Epoch {epoch} Loss: {total_loss.item():.4f} LR: {scheduler.get_last_lr()[0]:.6f}")

    model.eval()
    with torch.no_grad():
        test_out, _, _, _ = model(testing)
        test_loss = criterion(test_out.view(-1, VOCAB), testing_targets.view(-1))
        print(f"Test Loss: {test_loss.item():.4f}")
        print(test_out.shape)